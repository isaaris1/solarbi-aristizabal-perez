	measure TarifaCOP = 800
		formatString: 0
		lineageTag: 6a743a02-99fc-45ca-a692-e6bebcbd0b12

	measure Yield_kWh_kWp = DIVIDE([Total_Energia_kWh], 5.0, 0)
		lineageTag: a88dade3-f2b2-451f-adff-2d69d0678d0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ahorro_COP = [Total_Energia_kWh] * [TarifaCOP]
